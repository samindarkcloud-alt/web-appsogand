{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "web-appsogand",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "43704ffb-50ac-418b-a79d-5108df94db40","database_name": "Ihsbksla" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "4bcdd224ce4a4a419d2ab41ddf6acc9f" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
